<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SmartBusinessManager.Features.AI.Views.InsightsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:SmartBusinessManager.Features.AI.ViewModels"
    xmlns:models="clr-namespace:SmartBusinessManager.Features.AI.Models"
    x:DataType="viewmodels:InsightsViewModel"
    Title="التحليلات الذكية"
    BackgroundColor="#F8F9FD">

    <Grid RowDefinitions="Auto,*" Padding="20">

        <!-- ── SECTION 1: HEADER & ACTIONS ── -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                <Label Text="مساعد الأعمال الذكي 🤖" 
                       TextColor="{StaticResource Primary}" 
                       FontSize="13" 
                       FontFamily="OpenSansSemibold" 
                       CharacterSpacing="1" />
                <Label Text="التحليلات الذكية" 
                       TextColor="{StaticResource TextPrimary}" 
                       FontSize="26" 
                       FontFamily="OpenSansSemibold" 
                       Margin="0,4,0,0" />
            </VerticalStackLayout>

            <Button Grid.Column="1" 
                    Text="تحديث ✨" 
                    Command="{Binding GenerateInsightsCommand}" 
                    BackgroundColor="{StaticResource Primary}" 
                    TextColor="{StaticResource White}" 
                    CornerRadius="14" 
                    FontFamily="OpenSansSemibold"
                    FontSize="14"
                    Padding="20,12"
                    HeightRequest="48"
                    VerticalOptions="Center">
                <Button.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="8" Opacity="0.15"/>
                </Button.Shadow>
            </Button>
        </Grid>

        <!-- ── SECTION 2: CONTENT AREA ── -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">

            <!-- 🚨 ERROR TOAST BANNER 🚨 -->
            <Border Grid.Row="0" 
                    IsVisible="{Binding HasError}" 
                    BackgroundColor="#FFF5F5" 
                    Stroke="#FEB2B2" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 12" 
                    Padding="14" 
                    Margin="0,0,0,16">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="⚠️" FontSize="18" VerticalOptions="Center" />
                    <Label Grid.Column="1" 
                           Text="{Binding ErrorMessage}" 
                           TextColor="#C53030" 
                           FontFamily="OpenSansRegular"
                           FontSize="13" 
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- 🔄 REFRESH VIEW + MAIN DATA 🔄 -->
            <RefreshView Grid.Row="1" 
                         IsRefreshing="{Binding IsBusy}" 
                         Command="{Binding LoadInsightsCommand}"
                         RefreshColor="{StaticResource Primary}">

                <Grid>
                    <!-- 📋 CollectionView for Insights -->
                    <CollectionView ItemsSource="{Binding Insights}" 
                                    IsVisible="{Binding HasInsights}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:AiInsight">
                                <Border Margin="0,0,0,14" 
                                        StrokeThickness="1.5" 
                                        StrokeShape="RoundRectangle 16"
                                        Padding="18">
                                    <Border.Shadow>
                                        <Shadow Brush="#000" Offset="0,2" Radius="6" Opacity="0.03"/>
                                    </Border.Shadow>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="1">
                                            <Setter Property="BackgroundColor" Value="#FFF5F5" />
                                            <Setter Property="Stroke" Value="#FEB2B2" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="2">
                                            <Setter Property="BackgroundColor" Value="#FFFAF0" />
                                            <Setter Property="Stroke" Value="#FEEBC8" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Priority}" Value="3">
                                            <Setter Property="BackgroundColor" Value="#F0FFF4" />
                                            <Setter Property="Stroke" Value="#C6F6D5" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                                        <!-- Priority Indicator & Title Badge -->
                                        <Label Grid.Row="0" Grid.Column="0" 
                                               FontFamily="OpenSansSemibold" 
                                               FontSize="11" 
                                               CharacterSpacing="0.5">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Priority}" Value="1">
                                                    <Setter Property="Text" Value="عاجل جداً • أولوية قصوى 🚨" />
                                                    <Setter Property="TextColor" Value="#C53030" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Priority}" Value="2">
                                                    <Setter Property="Text" Value="مستحق ومهم • أولوية متوسطة ⚠️" />
                                                    <Setter Property="TextColor" Value="#C05621" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Priority}" Value="3">
                                                    <Setter Property="Text" Value="تحليل ذكي • أولوية منخفضة 💡" />
                                                    <Setter Property="TextColor" Value="#2F855A" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <!-- The AI Message Text -->
                                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding Message}" 
                                               TextColor="{StaticResource TextPrimary}" 
                                               FontFamily="OpenSansRegular"
                                               FontSize="14.5" 
                                               LineHeight="1.3"
                                               LineBreakMode="WordWrap"
                                               Margin="0,4,0,10" />

                                        <!-- Footer: Timestamp -->
                                        <Label Grid.Row="2" Grid.Column="0" 
                                               Text="{Binding GeneratedAt, StringFormat='تم التحليل: {0:yyyy-MM-dd HH:mm}'}" 
                                               TextColor="{StaticResource TextMuted}" 
                                               FontFamily="OpenSansRegular"
                                               FontSize="11.5" 
                                               VerticalOptions="Center" />

                                        <!-- Footer: Mark as Read Action Button -->
                                        <Button Grid.Row="2" Grid.Column="1" 
                                                Text="تمت القراءة ✓" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:InsightsViewModel}}, Path=MarkAsReadCommand}" 
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource White}" 
                                                TextColor="{StaticResource TextSecondary}" 
                                                StrokeColor="{StaticResource Border}"
                                                StrokeThickness="1"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="11" 
                                                CornerRadius="10" 
                                                Padding="12,4"
                                                HeightRequest="34"
                                                VerticalOptions="Center">
                                            <Button.Shadow>
                                                <Shadow Brush="#000" Offset="0,1" Radius="2" Opacity="0.05"/>
                                            </Button.Shadow>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- 🤖 EMPTY STATE SCREEN -->
                    <VerticalStackLayout IsVisible="{Binding IsEmpty}" 
                                         VerticalOptions="Center" 
                                         HorizontalOptions="Center" 
                                         Padding="30" 
                                         Spacing="16"
                                         MaximumWidthRequest="360">
                        
                        <Border HeightRequest="90"
                                WidthRequest="90"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource PrimaryLight}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Margin="0,0,0,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="45" />
                            </Border.StrokeShape>
                            <Label Text="🤖" 
                                   FontSize="40" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" />
                        </Border>

                        <Label Text="لا توجد تحليلات حالياً" 
                               TextColor="{StaticResource TextPrimary}" 
                               FontFamily="OpenSansSemibold"
                               FontSize="18" 
                               HorizontalTextAlignment="Center" />
                        
                        <Label Text="اضغط على زر التحديث في الأعلى لتوليد نصائح ذكية مبنية على أداء عملائك، وتواريخ فواتيرهم، وسجل تواصلك معهم." 
                               TextColor="{StaticResource TextSecondary}" 
                               FontFamily="OpenSansRegular"
                               FontSize="13.5" 
                               LineHeight="1.3"
                               HorizontalTextAlignment="Center" 
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
