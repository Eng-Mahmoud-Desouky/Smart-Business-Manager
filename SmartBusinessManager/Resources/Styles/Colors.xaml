<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#3525cd</Color>
    <Color x:Key="PrimaryDark">#0f0069</Color>
    <Color x:Key="PrimaryLight">#e2dfff</Color>

    <Color x:Key="Success">#006c49</Color>
    <Color x:Key="SuccessBg">#6cf8bb</Color>

    <Color x:Key="Warning">#7e3000</Color>
    <Color x:Key="WarningBg">#ffdbcc</Color>

    <Color x:Key="Danger">#ba1a1a</Color>
    <Color x:Key="DangerBg">#ffdad6</Color>

    <Color x:Key="TextPrimary">#1b1b24</Color>
    <Color x:Key="TextSecondary">#464555</Color>
    <Color x:Key="TextMuted">#777587</Color>

    <Color x:Key="Border">#c7c4d8</Color>
    <Color x:Key="Surface">#fcf8ff</Color>
    <Color x:Key="White">#ffffff</Color>

    <!-- Added Missing Colors -->
    <Color x:Key="OnSurfaceVariant">#49454f</Color>
    <Color x:Key="SurfaceDim">#ded8e1</Color>
    <Color x:Key="SurfaceContainerLowest">#ffffff</Color>
    <Color x:Key="Error">#ba1a1a</Color>
    <Color x:Key="Outline">#79747e</Color>
    <Color x:Key="OnBackground">#1d1b20</Color>
    <Color x:Key="PrimaryContainer">#eaddff</Color>
    <Color x:Key="OnPrimaryContainer">#21005d</Color>
    <Color x:Key="SecondaryContainer">#e8def8</Color>
    
    <!-- More Missing Colors -->
    <Color x:Key="OnPrimary">#ffffff</Color>
    <Color x:Key="PrimaryFixedDim">#cbc2ff</Color>
    <Color x:Key="Secondary">#5e5c71</Color>

