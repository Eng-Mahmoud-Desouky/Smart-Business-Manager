<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SmartBusinessManager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:SmartBusinessManager.Features.Authentication.Views"
    xmlns:dash="clr-namespace:SmartBusinessManager.Features.Dashboard.Views"
    xmlns:clients="clr-namespace:SmartBusinessManager.Features.Clients.Views"
    xmlns:finance="clr-namespace:SmartBusinessManager.Features.Finance.Views"
    xmlns:ai="clr-namespace:SmartBusinessManager.Features.AI.Views"
    Shell.FlyoutBehavior="Disabled">

    <!-- ── Auth (no tab bar) ──────────────────────────── -->
    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate auth:LoginPage}"
        Shell.TabBarIsVisible="False"/>

    <ShellContent
        Route="register"
        ContentTemplate="{DataTemplate auth:RegisterPage}"
        Shell.TabBarIsVisible="False"/>

    <!-- ── Main Tab Bar ──────────────────────────────── -->
    <TabBar>
        <Tab Title="Dashboard" Icon="icon_dashboard.png">
            <ShellContent
                Route="dashboard"
                ContentTemplate="{DataTemplate dash:DashboardPage}"/>
        </Tab>

        <Tab Title="Clients" Icon="icon_clients.png">
            <ShellContent
                Route="clients"
                ContentTemplate="{DataTemplate clients:ClientListPage}"/>
        </Tab>

        <Tab Title="Finance" Icon="icon_finance.png">
            <ShellContent
                Route="payments"
                ContentTemplate="{DataTemplate finance:PaymentListPage}"/>
        </Tab>

        <Tab Title="Insights" Icon="icon_ai.png">
            <ShellContent
                Route="insights"
                ContentTemplate="{DataTemplate ai:InsightsPage}"/>
        </Tab>
    </TabBar>

</Shell>
