<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartBusinessManager.Shared.Components.Forms.FormInputField"
             x:Name="self"
             BackgroundColor="Transparent">

    <VerticalStackLayout Spacing="6"
                         HorizontalOptions="Fill">

        <!-- Input Field Header Label (Column header) -->
        <Label x:Name="FieldLabel"
               Text="{Binding Label, Source={x:Reference self}}"
               FontFamily="OpenSansSemibold"
               FontSize="13"
               TextColor="{StaticResource OnSurfaceVariant}"
               IsVisible="{Binding Label, Source={x:Reference self}, Converter={StaticResource StringNotNullOrEmptyConverter}}"
               Margin="4,0,0,0" />

        <!-- Input Box Container (Borders and interactive states) -->
        <Border x:Name="InputBorder"
                StrokeThickness="1"
                Stroke="{StaticResource SurfaceDim}"
                BackgroundColor="{StaticResource SurfaceContainerLowest}"
                HeightRequest="48"
                Padding="12,0"
                HorizontalOptions="Fill">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            
            <Border.Triggers>
                <!-- Red Alert Border Trigger on validation error -->
                <DataTrigger TargetType="Border" Binding="{Binding HasError, Source={x:Reference self}}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource Error}" />
                    <Setter Property="StrokeThickness" Value="1.5" />
                </DataTrigger>
            </Border.Triggers>

            <Grid ColumnDefinitions="*,Auto"
                  VerticalOptions="Fill"
                  HorizontalOptions="Fill">

                <!-- Core TextInput Field -->
                <Entry x:Name="CoreEntry"
                       Grid.Column="0"
                       Text="{Binding Text, Source={x:Reference self}, Mode=TwoWay}"
                       Placeholder="{Binding Placeholder, Source={x:Reference self}}"
                       PlaceholderColor="{StaticResource Outline}"
                       Keyboard="{Binding Keyboard, Source={x:Reference self}}"
                       IsPassword="{Binding IsPassword, Source={x:Reference self}}"
                       TextColor="{StaticResource OnBackground}"
                       FontFamily="OpenSansRegular"
                       FontSize="15"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center"
                       HorizontalOptions="Fill"
                       Focused="OnEntryFocused"
                       Unfocused="OnEntryUnfocused" />

                <!-- Password Hide/Show Icon Action Button -->
                <Button Grid.Column="1"
                        x:Name="TogglePasswordButton"
                        Text="👁"
                        FontFamily="OpenSansRegular"
                        FontSize="16"
                        TextColor="{StaticResource Outline}"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        HeightRequest="40"
                        WidthRequest="40"
                        Padding="0"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        IsVisible="{Binding IsPasswordControl, Source={x:Reference self}}"
                        Clicked="OnTogglePasswordClicked" />
            </Grid>
        </Border>

        <!-- Dynamic Error Validation Text Label -->
        <Label x:Name="ErrorLabel"
               Text="{Binding ErrorMessage, Source={x:Reference self}}"
               FontFamily="OpenSansRegular"
               FontSize="11"
               TextColor="{StaticResource Error}"
               IsVisible="{Binding HasError, Source={x:Reference self}}"
               Margin="4,0,0,0" />

    </VerticalStackLayout>
</ContentView>
