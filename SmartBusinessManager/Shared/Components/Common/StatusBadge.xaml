<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartBusinessManager.Shared.Components.Common.StatusBadge"
             x:Name="self"
             BackgroundColor="Transparent"
             HorizontalOptions="Start"
             VerticalOptions="Center">

    <!-- Clean, pill-shaped container for status badges -->
    <Border x:Name="BadgeBorder"
            StrokeThickness="0"
            Padding="10,4"
            HeightRequest="24"
            HorizontalOptions="Start"
            VerticalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" /> <!-- Pill shape -->
        </Border.StrokeShape>

        <Label x:Name="BadgeLabel"
               Text="{Binding Text, Source={x:Reference self}}"
               FontFamily="OpenSansSemibold"
               FontSize="11"
               CharacterSpacing="0.2"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
    </Border>
</ContentView>
