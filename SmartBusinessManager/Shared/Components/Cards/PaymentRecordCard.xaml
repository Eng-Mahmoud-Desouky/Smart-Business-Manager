<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:common="clr-namespace:SmartBusinessManager.Shared.Components.Common"
             x:Class="SmartBusinessManager.Shared.Components.Cards.PaymentRecordCard"
             x:Name="self"
             BackgroundColor="Transparent">

    <!-- Card Outer Container -->
    <Border StrokeThickness="1"
            Stroke="{StaticResource SurfaceDim}"
            BackgroundColor="{StaticResource SurfaceContainerLowest}"
            Margin="0,0,0,8"
            Padding="12"
            HorizontalOptions="Fill">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="6" Opacity="0.02" />
        </Border.Shadow>

        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped" />
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12"
              VerticalOptions="Center"
              HorizontalOptions="Fill">

            <!-- 1. Transaction Visual Emblem (Column 0) -->
            <Border Grid.Column="0"
                    HeightRequest="42"
                    WidthRequest="42"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource SecondaryContainer}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="21" /> <!-- Perfect Circle -->
                </Border.StrokeShape>

                <Label Text="💰"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- 2. Client Details Stack (Column 1) -->
            <VerticalStackLayout Grid.Column="1"
                                 VerticalOptions="Center"
                                 Spacing="2">
                <Label Text="{Binding ClientName, Source={x:Reference self}}"
                       FontFamily="OpenSansSemibold"
                       FontSize="14"
                       TextColor="{StaticResource OnBackground}"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding DateText, Source={x:Reference self}}"
                       FontFamily="OpenSansRegular"
                       FontSize="11"
                       TextColor="{StaticResource Outline}"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <!-- 3. Financial Metrics & Badge Stack (Column 2) -->
            <VerticalStackLayout Grid.Column="2"
                                 HorizontalOptions="End"
                                 VerticalOptions="Center"
                                 Spacing="4">
                
                <!-- Financial Amount Display -->
                <Label Text="{Binding AmountText, Source={x:Reference self}}"
                       FontFamily="OpenSansSemibold"
                       FontSize="14"
                       TextColor="{StaticResource OnBackground}"
                       HorizontalOptions="End"
                       VerticalOptions="Center" />

                <!-- Nested Status Badge -->
                <common:StatusBadge Status="{Binding Status, Source={x:Reference self}}"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center" />
            </VerticalStackLayout>

        </Grid>
    </Border>
</ContentView>
